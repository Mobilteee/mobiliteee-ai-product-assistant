# VCS / tooling
.git
.gitignore

# Secrets (never baked into images)
.env
.env.local
.env.*.local
.streamlit/

# Python
.venv/
__pycache__/
**/__pycache__/
*.pyc

# Runtime data (bind/volume in prod, don't bake)
data/
*.db

# Frontend is deployed separately (Vercel); not part of the backend image.
frontend/
node_modules/
.next/

# Tests / docs helpers not needed at runtime
tests/
# Keep committed eval artifacts available to Docker; only scratch dirs are excluded.
evals/.tmp_*
scripts/
docs/

# Scratch / design system (kept out of the image). NOTE: do NOT add `*.txt`
# here — it would also exclude requirements.txt from the Docker build context.
*~
*.log
DESIGN_SYSTEMS.md

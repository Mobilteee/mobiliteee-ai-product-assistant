# =============================================================================
# AI Product Knowledge Assistant — environment template
# Copy to `.env` (local) or set as platform env vars (Railway/Render/Supabase).
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Demo channel (deployer-held credentials)
# Used ONLY when a visitor has NOT provided their own API key (X-Custom-Api-Key /
# profile key). These calls are protected by the demo rate limits below.
# NOTE: fill a real, current model name. Example: the DeepSeek gateway currently
# rejects `deepseek-chat`; use e.g. `deepseek-v4-flash` there.
# -----------------------------------------------------------------------------
DEMO_CHAT_API_KEY=
DEMO_CHAT_BASE_URL=https://api.deepseek.com
DEMO_CHAT_MODEL=

# Optional: embedding model. If left empty, retrieval auto-falls back to lexical
# BM25 so a chat-only key still works. SiliconFlow example: BAAI/bge-m3.
DEMO_EMBED_API_KEY=
DEMO_EMBED_BASE_URL=
DEMO_EMBED_MODEL=

# -----------------------------------------------------------------------------
# CORS domain allowlist (comma separated) — put your real frontend origin(s) here.
# e.g. https://your-app.vercel.app
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# naive | hybrid | hybrid_parent_child
RETRIEVAL_STRATEGY=hybrid_parent_child

# -----------------------------------------------------------------------------
# Demo fair-use rate limits (visitors WITHOUT a custom key; BYOK bypasses these)
# RATE_LIMIT_GLOBAL_PER_MIN : shared real-LLM calls per minute across all visitors
# RATE_LIMIT_IP_PER_HOUR    : arbitrary ("custom") questions per IP per hour
# -----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MIN=8
RATE_LIMIT_IP_PER_HOUR=8

# -----------------------------------------------------------------------------
# Database
# Current implementation is local SQLite. DATA_DIR points at the sqlite folder;
# in Docker mount a volume there so uploads/history survive redeploys.
# Supabase/PostgreSQL (pgvector) is a roadmap adapter — see docs/SUPABASE_DEPLOY.md.
# When the Postgres adapter lands, set DATABASE_URL instead, e.g.:
#   postgresql://postgres:YOURPASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
# -----------------------------------------------------------------------------
# Unset default = <repo>/data. In Docker keep /app/data and mount a volume there
# so uploads/history survive redeploys.
DATA_DIR=/app/data
# DATABASE_URL=

# -----------------------------------------------------------------------------
# Misc / infra
# -----------------------------------------------------------------------------
# Client IP is taken from X-Forwarded-For first (set by Railway/Render/proxy).
# Bind/port used by the container entrypoint (uvicorn). Not usually overridden.
# HOST=0.0.0.0
# PORT=8000
